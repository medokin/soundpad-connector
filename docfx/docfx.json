{
  "metadata": [
    {
      "src": [
        {
          "files": ["SoundpadConnector/SoundpadConnector.csproj"],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "../src"
        }
      ],
      "dest": "../artifacts/docfx-api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**.yml"
        ],
        "src": "../artifacts/docfx-api",
        "dest": "api"
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md",
          "api/index.md"
        ]
      },
      {
        "files": ["README.md"],
        "src": "..",
        "dest": "articles"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "../artifacts/docs",
    "globalMetadata": {
      "_appTitle": "SoundpadConnector",
      "_appName": "SoundpadConnector",
      "_appLogoPath": "images/logo.png",
      "_enableSearch": true
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "templates/custom"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
  
}
